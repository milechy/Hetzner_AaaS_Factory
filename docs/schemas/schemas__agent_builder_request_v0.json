{
  "$id": "https://aaas-factory.local/schemas/agent-builder-request.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentBuilderRequestV0",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "specFormat", "target"],
  "properties": {
    "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "specFormat": { "type": "string", "enum": ["yaml", "json", "auto"] },
    "specText": { "type": "string", "minLength": 1 },
    "specObject": { "type": "object" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoKind", "language", "framework"],
      "properties": {
        "repoKind": { "type": "string", "enum": ["monorepo", "single"] },
        "language": { "type": "string", "enum": ["typescript", "python", "swift"] },
        "framework": { "type": "string", "enum": ["nextjs", "fastapi", "swiftui", "agents-sdk"] },
        "runtime": { "type": "string", "enum": ["node20", "python311", "swift59"], "default": "python311" }
      }
    },
    "routingProfile": {
      "type": "string",
      "enum": ["planner_standard", "codegen_standard", "reviewer_standard", "docgen_standard"],
      "default": "codegen_standard"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "highRiskDomains": {
          "type": "array",
          "items": { "type": "string", "enum": ["infra", "security", "billing", "template"] },
          "default": ["infra", "security", "billing", "template"]
        },
        "disallowNetwork": { "type": "boolean", "default": true },
        "proposalOnly": { "type": "boolean", "const": true }
      }
    },
    "repoContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseBranch": { "type": "string", "default": "main" },
        "existingTree": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "anyOf": [{ "required": ["specText"] }, { "required": ["specObject"] }]
}