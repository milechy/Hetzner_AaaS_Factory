{
  "$id": "https://aaas-factory.local/schemas/pull-request-proposal.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PullRequestProposalV0",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "requestId", "title", "summary", "risk", "changes", "validation", "metadata"],
  "properties": {
    "proposalId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 4000 },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "notes", "highRiskDetected"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "highRiskDetected": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "dependencies"],
      "properties": {
        "directories": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "content"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "enum": ["create", "modify", "delete"] },
              "content": { "type": "string" },
              "contentType": {
                "type": "string",
                "enum": ["text", "json", "yaml", "python", "typescript", "swift", "md"],
                "default": "text"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "name", "requestedVersion"],
            "properties": {
              "ecosystem": { "type": "string", "enum": ["npm", "pip", "swiftpm"] },
              "name": { "type": "string" },
              "requestedVersion": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "manualSteps"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "command"],
            "properties": {
              "kind": { "type": "string", "enum": ["lint", "test", "build", "typecheck"] },
              "command": { "type": "string" },
              "cwd": { "type": "string" }
            }
          }
        },
        "manualSteps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routerProfile", "modelAgnostic", "createdAt"],
      "properties": {
        "routerProfile": { "type": "string" },
        "modelAgnostic": { "type": "boolean", "const": true },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}